{
  "name": "ai-kayori",
  "version": "4.3.0",
  "productName": "AI-Kayori",
  "description": "AI-Kayori — приватный AI ассистент с котиком. Чёрная тема, Google Gemini + Cloudflare Workers AI.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && mkdir -p dist-electron && cp electron/*.cjs dist-electron/ && electron-builder --config electron-builder.yml",
    "electron:build:portable": "vite build && mkdir -p dist-electron && cp electron/*.cjs dist-electron/ && electron-builder --config electron-builder.portable.yml",
    "electron:build:setup": "vite build && mkdir -p dist-electron && cp electron/*.cjs dist-electron/ && electron-builder --config electron-builder.setup.yml",
    "build:apk": "vite build && npx cap copy android && npx cap open android",
    "lint": "eslint .",
    "version:patch": "npm version patch && node scripts/update-version.js",
    "version:minor": "npm version minor && node scripts/update-version.js",
    "check-updates": "node scripts/check-updates.js",
    "build:check": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "fflate": "^0.8.3",
    "framer-motion": "^11.3.0",
    "idb": "^8.0.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@types/dompurify": "^3.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kayori.ai",
    "productName": "AI-Kayori",
    "copyright": "Copyright © 2026 Kayori",
    "icon": "public/icons/icon.png"
  },
  "capacitor": {
    "appId": "com.kayori.ai",
    "appName": "AI-Kayori",
    "webDir": "dist"
  }
}
